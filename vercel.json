{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/state", "destination": "/data/state.json" },
    { "source": "/download/:match*", "destination": "/exports/:match*" }
  ]
}
