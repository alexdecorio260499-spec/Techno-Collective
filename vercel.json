{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/styles.css", "destination": "/public/styles.css" },
    { "source": "/app.js", "destination": "/public/app.js" },
    { "source": "/src/:match*", "destination": "/public/src/:match*" },
    { "source": "/api/state", "destination": "/data/state.json" },
    { "source": "/download/:match*", "destination": "/exports/:match*" }
  ]
}
